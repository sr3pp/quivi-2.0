# Node Environment
NODE_ENV=development

# Database
MONGO_URL=mongodb://localhost:27017/your-database-name

# JWT
JWT_SECRET=your-jwt-secret-key-here

# SAE (Sistema de Administración Empresarial)
SAE_URL=https://your-sae-api-url.com

# Email Configuration (Production)
EMAIL_HOST=smtp.your-email-provider.com
EMAIL_PORT=587
EMAIL_USER=your-email@domain.com
EMAIL_PASS=your-email-password
EMAIL_TEST_MAIL=test@example.com

# Email Configuration (Development/Testing - Mailtrap or similar)
TRAP_HOST=smtp.mailtrap.io
TRAP_PORT=2525
TRAP_USER=your-mailtrap-user
TRAP_PASS=your-mailtrap-password

# OpenPay Configuration (Production)
OPENPAY_URL=https://api.openpay.mx/v1
OPENPAY_BARCODE_URL=https://sandbox-api.openpay.mx/barcode
OPENPAY_KEY=your-openpay-production-key
OPENPAY_MERCHANT_ID=your-openpay-merchant-id

# OpenPay Configuration (Development)
OPENPAY_DEV_URL=https://sandbox-api.openpay.mx/v1
OPENPAY_BARCODE_DEV_URL=https://sandbox-api.openpay.mx/barcode
OPENPAY_DEV_KEY=your-openpay-dev-key
OPENPAY_DEV_MERCHANT_ID=your-openpay-dev-merchant-id

# OpenPay Environment Switch
OPENPAY_PRODUCTION=false

# PayPal Configuration (Production)
PAYPAL_URL=https://api-m.paypal.com
PAYPAL_CLIENT=your-paypal-production-client-id
PAYPAL_SECRET=your-paypal-production-secret

# PayPal Configuration (Development)
PAYPAL_DEV_URL=https://api-m.sandbox.paypal.com
PAYPAL_DEV_CLIENT=your-paypal-sandbox-client-id
PAYPAL_DEV_SECRET=your-paypal-sandbox-secret

# Chatwoot
CHATWOOT_WEBSITE_TOKEN=your-chatwoot-website-token

# Server Configuration
IS_VPS=false
